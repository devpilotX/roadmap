<!DOCTYPE html>
<html lang="en" data-theme="<%= locals.theme || 'system' %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="color-scheme" content="light dark">
  <meta name="robots" content="noindex, nofollow">
  <title><%= title %> | The Roadmap Tracker</title>
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="icon" href="/img/icon.svg" type="image/svg+xml">
  <meta name="theme-color" content="#2783DE">
  <link rel="stylesheet" href="/css/tokens.css">
  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/layout.css">
  <link rel="stylesheet" href="/css/components.css">
  <% (locals.styles || []).forEach(function (s) { %>
  <link rel="stylesheet" href="/css/screens/<%= s %>.css">
  <% }); %>
</head>
<body data-page="<%= locals.page || '' %>" data-today="<%= today %>" data-csrf="<%= locals.csrfToken || '' %>">
  <a class="skip-link" href="#main">Skip to content</a>

  <div class="app">
    <%- include('sidebar') %>

    <div class="main">
      <%- include('topbar') %>

      <div class="syncbar" id="syncbar" data-show="0" role="status">
        <svg class="callout__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v10M8 9l4 4 4-4M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/></svg>
        <span id="syncbar-text">You are offline. Ticks are saved on this device and will sync when you reconnect.</span>
      </div>

      <main class="content <%= locals.wide ? 'content--wide' : '' %>" id="main" tabindex="-1">
