<%
  // Five destinations for the bottom bar. Everything else stays one tap away
  // through the command palette, so the thumb reach stays honest on a 375px screen.
  const bottom = [
    { href: '/', label: 'Today', icon: 'M12 2v3M12 19v3M2 12h3M19 12h3M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10Z' },
    { href: '/calendar', label: 'Calendar', icon: 'M4 6h16v14H4zM4 10h16M8 3v4M16 3v4' },
    { href: '/dsa', label: 'DSA', icon: 'M9 8 5 12l4 4M15 8l4 4-4 4' },
    { href: '/money', label: 'Money', icon: 'M12 2v20M17 6.5C17 4.6 14.8 3.5 12 3.5S7 4.6 7 6.5s2.2 3 5 3.5 5 1.6 5 3.5-2.2 3-5 3-5-1.1-5-3' },
    { href: '/everything', label: 'All', icon: 'M4 6h16M4 12h16M4 18h16' }
  ];
%>
<nav class="bottombar" aria-label="Main navigation, compact">
  <% bottom.forEach(function (item) {
       const active = item.href === '/' ? currentPath === '/' : (currentPath === item.href || currentPath.indexOf(item.href + '/') === 0); %>
  <a class="bottombar__link" href="<%= item.href %>" <%= active ? 'aria-current="page"' : '' %>>
    <svg class="bottombar__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="<%= item.icon %>"/></svg>
    <span><%= item.label %></span>
  </a>
  <% }); %>
</nav>
