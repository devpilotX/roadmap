<div class="modal" id="palette" role="dialog" aria-modal="true" aria-labelledby="palette-label">
  <div class="modal__panel">
    <label class="visually-hidden" id="palette-label" for="palette-input">Search screens and jump</label>
    <input
      class="input"
      id="palette-input"
      type="search"
      placeholder="Jump to a screen, a week, or a date"
      autocomplete="off"
      spellcheck="false"
    >
    <ul class="kancol__list" id="palette-results" role="listbox" aria-labelledby="palette-label"></ul>
    <p class="text-xs muted">
      <kbd>Ctrl</kbd> <kbd>K</kbd> opens this. <kbd>Esc</kbd> closes it.
      Type a week number, a date like 2026-10-04, or the name of a screen.
    </p>
  </div>
</div>
