<header class="topbar">
  <h1 class="topbar__title"><%= locals.topbarTitle || title %></h1>
  <span class="topbar__spacer"></span>

  <% if (locals.isFakeClock) { %>
  <span class="badge badge--orange" title="FAKE_TODAY or FAKE_TIME is set in .env">Clock is faked: <%= today %></span>
  <% } %>

  <button type="button" class="iconbtn" id="palette-open" aria-label="Open the command palette. Keyboard shortcut Control K">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14ZM16 16l4 4"/></svg>
  </button>

  <div class="row-tight">
    <button type="button" class="iconbtn" id="bell-open" aria-label="Warnings" aria-expanded="false">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 15V10a6 6 0 1 0-12 0v5l-2 3h16zM10 21a2 2 0 0 0 4 0"/></svg>
    </button>
    <span class="badge badge--red" id="bell-count" hidden>0</span>
  </div>
</header>

<div class="modal" id="bell-panel" role="dialog" aria-modal="true" aria-labelledby="bell-title">
  <div class="modal__panel">
    <div class="between">
      <h2 id="bell-title" class="card__title">Active warnings</h2>
      <button type="button" class="iconbtn" data-close-bell aria-label="Close warnings">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
      </button>
    </div>
    <div id="bell-list" class="stack-sm">
      <p class="muted">Checking.</p>
    </div>
    <p class="text-xs muted">
      Red warnings cannot be dismissed. An orange warning can be snoozed for 24 hours, once.
    </p>
  </div>
</div>
