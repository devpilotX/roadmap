      </main>
    </div>
  </div>

  <%- include('bottombar') %>

  <div class="timerchip" id="timerchip" data-running="0">
    <span class="timerchip__pulse" aria-hidden="true"></span>
    <span class="timerchip__block" id="timerchip-block">DSA</span>
    <span class="timerchip__time" id="timerchip-time">0 m</span>
    <button type="button" class="btn btn--sm" id="timerchip-stop">Stop</button>
  </div>

  <div class="toasts" id="toasts" role="status" aria-live="polite" aria-atomic="false"></div>

  <%- include('palette') %>

  <script type="module" src="/js/boot.mjs"></script>
  <% (locals.scripts || []).forEach(function (s) { %>
  <script type="module" src="/js/screens/<%= s %>.mjs"></script>
  <% }); %>
</body>
</html>
