<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <meta name="robots" content="noindex, nofollow">
  <title><%= title %> | The Roadmap Tracker</title>
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="icon" href="/img/icon.svg" type="image/svg+xml">
  <meta name="theme-color" content="#2783DE">
  <link rel="stylesheet" href="/css/tokens.css">
  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/layout.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/screens/auth.css">
</head>
<body data-page="auth" data-csrf="<%= locals.csrfToken || '' %>" data-mode="signup" data-next="<%= next %>"
      data-min-password="<%= minPasswordLength %>">
  <main class="authpage">
    <div class="authcard">
      <div class="authcard__brand">
        <span class="sidebar__mark" aria-hidden="true">RT</span>
        <span>
          <span class="sidebar__title">The Roadmap Tracker</span>
          <span class="sidebar__sub">28 Aug 2026 to 24 Jan 2027</span>
        </span>
      </div>

      <h1 class="page-head__title">Create your account</h1>
      <p class="muted">Email and password. Nothing else, and nothing third party.</p>

      <form id="auth-form" method="post" action="/api/auth/signup" novalidate>
        <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">

        <div class="field">
          <label class="field__label" for="display_name">Your name</label>
          <input class="input" id="display_name" name="display_name" type="text"
                 autocomplete="name" required maxlength="120">
          <p class="field__error" id="display_name-error" role="alert"></p>
        </div>

        <div class="field">
          <label class="field__label" for="email">Email</label>
          <input class="input" id="email" name="email" type="email" autocomplete="username"
                 inputmode="email" required maxlength="255" spellcheck="false">
          <p class="field__error" id="email-error" role="alert"></p>
        </div>

        <div class="field">
          <label class="field__label" for="password">Password</label>
          <div class="pwwrap">
            <input class="input" id="password" name="password" type="password"
                   autocomplete="new-password" required maxlength="200"
                   aria-describedby="strength-text pw-hint">
            <button type="button" class="btn btn--sm btn--ghost" id="pw-toggle" aria-label="Show password">Show</button>
          </div>
          <div class="strength" id="strength" data-score="0">
            <div class="strength__bars" aria-hidden="true">
              <span class="strength__bar" data-on="0"></span>
              <span class="strength__bar" data-on="0"></span>
              <span class="strength__bar" data-on="0"></span>
              <span class="strength__bar" data-on="0"></span>
            </div>
            <p class="strength__text" id="strength-text" aria-live="polite">
              At least <%= minPasswordLength %> characters. Length beats symbols.
            </p>
          </div>
          <p class="field__hint" id="pw-hint">
            Checked against a local list of commonly used passwords. Hashed with Argon2id.
          </p>
          <p class="field__error" id="password-error" role="alert"></p>
        </div>

        <p class="field__error" id="form-error" role="alert"></p>

        <button class="btn btn--primary btn--block btn--lg" type="submit" id="submit">Create account</button>
      </form>

      <p class="text-sm muted authcard__alt">
        Already have an account? <a href="/login">Sign in</a>.
      </p>
    </div>
  </main>

  <div class="toasts" id="toasts" role="status" aria-live="polite"></div>
  <script type="module" src="/js/screens/auth.mjs"></script>
</body>
</html>
