<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <meta name="robots" content="noindex, nofollow">
  <title><%= title %> | The Roadmap Tracker</title>
  <link rel="icon" href="/img/icon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/tokens.css">
  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/layout.css">
  <link rel="stylesheet" href="/css/components.css">
</head>
<body data-page="error">
  <main class="authpage">
    <div class="authcard">
      <div class="authcard__brand">
        <span class="sidebar__mark" aria-hidden="true">RT</span>
        <span>
          <span class="sidebar__title">The Roadmap Tracker</span>
          <span class="sidebar__sub">Error <%= status %></span>
        </span>
      </div>
      <h1 class="page-head__title"><%= heading %></h1>
      <p class="muted"><%= message %></p>
      <div class="row">
        <a class="btn btn--primary" href="/">Go to Today</a>
        <a class="btn" href="/everything">Everything A to Z</a>
      </div>
    </div>
  </main>
</body>
</html>
