<%- include('../partials/head') %>

<div class="page-head">
  <h1 class="page-head__title">Calendar</h1>
  <p class="page-head__lede">Every day, every task, one click from the material.</p>
</div>

<section class="stack-sm" id="c-toolbar" aria-label="Calendar controls">
  <div class="card"><p class="muted">Loading calendar controls.</p></div>
</section>

<section class="" id="c-grid" aria-label="The month grid">
  <div class="card"><p class="muted">Loading the month grid.</p></div>
</section>

<section class="stack" id="c-foot" aria-label="Calendar notes">
  <div class="card"><p class="muted">Loading calendar notes.</p></div>
</section>

<div class="scrim" id="c-scrim" data-open="0"></div>
<aside class="drawer" id="c-drawer" data-open="0" role="dialog" aria-modal="true" aria-labelledby="c-drawer-title" tabindex="-1">
  <div class="drawer__head">
    <div class="grow">
      <h2 class="drawer__title" id="c-drawer-title">A day</h2>
      <p class="drawer__sub" id="c-drawer-sub"></p>
    </div>
    <button type="button" class="iconbtn" id="c-drawer-close" aria-label="Close the day">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
    </button>
  </div>
  <div class="drawer__body" id="c-drawer-body"></div>
</aside>

<%- include('../partials/foot') %>
