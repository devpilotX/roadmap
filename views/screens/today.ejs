<%- include('../partials/head') %>

<div class="page-head">
  <div class="between">
    <div>
      <h1 class="page-head__title" id="t-date"><%= todayLong %></h1>
      <p class="page-head__lede" id="t-week">Loading the day.</p>
    </div>
    <div class="row" id="t-actions">
      <a class="btn btn--sm" href="/calendar">Calendar</a>
      <a class="btn btn--sm" href="/print/week">Print this week</a>
    </div>
  </div>
</div>

<div class="todaystrip" id="t-strip" aria-label="Where today sits in the roadmap">
  <div class="todaystrip__item"><span class="stat__value" id="t-day-number">-</span><span class="stat__label">of 150 days</span></div>
  <div class="todaystrip__item"><span class="stat__value" id="t-week-n">-</span><span class="stat__label" id="t-phase">Phase</span></div>
  <div class="todaystrip__item"><span class="stat__value" id="t-gate-days">-</span><span class="stat__label" id="t-gate-label">to the next gate</span></div>
  <div class="todaystrip__item"><span class="stat__value" id="t-end-days">-</span><span class="stat__label">to 24 Jan 2027</span></div>
  <div class="todaystrip__item"><span class="stat__value" id="t-streak">-</span><span class="stat__label">day streak</span></div>
  <div class="todaystrip__item"><span class="stat__value" id="t-dsa-total">-</span><span class="stat__label" id="t-dsa-label">problems solved</span></div>
</div>

<div id="t-override" hidden></div>

<div class="split" id="t-main">
  <div class="stack">
    <section id="t-before" class="stack-sm" aria-label="Earlier blocks"></section>
    <section id="t-now" aria-label="The block you are in now">
      <div class="card card--now">
        <p class="card__label">Loading</p>
        <p class="muted">Reading the clock and today's tasks.</p>
      </div>
    </section>
    <section id="t-after" class="stack-sm" aria-label="Later blocks"></section>
  </div>

  <aside class="stack" aria-label="Today at a glance">
    <div class="card">
      <div class="card__head">
        <h2 class="card__title">Six conditions</h2>
        <span id="t-colour"></span>
      </div>
      <p class="text-sm muted" id="t-conditions-count">All six, or the day is not green.</p>
      <ul class="condlist" id="t-conditions"></ul>
    </div>

    <div class="card" id="t-failed-card" hidden>
      <div class="card__head">
        <h2 class="card__title">Failed twice</h2>
        <span class="badge badge--red" id="t-failed-count">0</span>
      </div>
      <p class="text-sm muted">Each one stays here until it is solved cold.</p>
      <ul class="condlist" id="t-failed"></ul>
    </div>

    <div class="card" id="t-warnings-card" hidden>
      <div class="card__head">
        <h2 class="card__title">Active warnings</h2>
      </div>
      <div class="stack-sm" id="t-warnings"></div>
    </div>

    <div class="card">
      <div class="card__head">
        <h2 class="card__title">Yesterday</h2>
        <span id="t-yesterday-colour"></span>
      </div>
      <p id="t-yesterday" class="text-sm muted">Loading.</p>
    </div>
  </aside>
</div>

<%- include('../partials/foot') %>
