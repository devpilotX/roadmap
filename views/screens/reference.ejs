<%- include('../partials/head') %>

<div class="page-head">
  <h1 class="page-head__title">Reference</h1>
  <p class="page-head__lede">The corrections, the pins, the skip list, and the verification log.</p>
</div>

<section class="stack-sm" id="rf-nav" aria-label="Jump to">
  <div class="card"><p class="muted">Loading jump to.</p></div>
</section>

<section class="stack-lg" id="rf-body" aria-label="Reference tables">
  <div class="card"><p class="muted">Loading reference tables.</p></div>
</section>

<section class="stack" id="rf-appendix-g" aria-label="Verification log">
  <div class="card">
    <div class="card__head">
      <h2 class="card__title">Verification log</h2>
      <span class="badge badge--outline">Read only, Appendix G</span>
    </div>
    <p class="text-sm muted">
      Appendix G of final.md is a record, not seed data. It is never parsed into rows
      and never stored in the database. It is rendered here straight from the file.
    </p>
    <% if (verificationLogFound) { %>
    <div class="md md--wide"><%- verificationLogHtml %></div>
    <% } else { %>
    <p class="muted">Appendix G was not found in data/final.md.</p>
    <% } %>
  </div>
</section>

<%- include('../partials/foot') %>
