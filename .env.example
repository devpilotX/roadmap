# ------------------------------------------------------------------
# The Roadmap Tracker | environment
#
# Copy to .env and fill in. Never commit .env.
#   cp .env.example .env
# ------------------------------------------------------------------

NODE_ENV=development

# The app binds to 127.0.0.1 only. nginx or the Hostinger router sits in front.
# Hostinger Node.js hosting injects PORT itself; leave this as a local default.
PORT=3000
HOST=127.0.0.1

# Public origin, used for absolute URLs in the ICS export and the manifest.
PUBLIC_ORIGIN=http://127.0.0.1:3000

# ---- MySQL -------------------------------------------------------
# On Hostinger these come from hPanel, Databases, Management.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=roadmap
DB_PASSWORD=change_me
DB_NAME=roadmap_tracker
DB_CONNECTION_LIMIT=10

# ---- Secrets -----------------------------------------------------
# 64 hex characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Generate a DIFFERENT value for each, and never reuse one from another project.
# SESSION_SECRET rotating signs everyone out, which is harmless.
# TOKEN_ENC_KEY rotating makes a stored GitHub token undecryptable: clear the
# token on /profile first. It is REQUIRED in production.
SESSION_SECRET=replace_with_64_hex_characters
TOKEN_ENC_KEY=replace_with_64_hex_characters

# ---- Who may create an account -----------------------------------
# This is one person's tracker, and /signup is reachable by anyone who finds it.
#   unset  signup is open only while the database has no users, so the first run
#          creates the account and the door closes by itself. This is the default
#          and it is what you want.
#   true   forced open. Only for recreating a lost account, and set it back after.
#   false  forced shut, even on an empty database.
# ALLOW_SIGNUP=

# ---- Behaviour ---------------------------------------------------
TIMEZONE=Asia/Kolkata
TRUST_PROXY=1

# Set to a fixed ISO date to test a specific day. Empty means the real clock.
# The date boundary tests in section 20.6 use 2026-08-28, 2026-08-31,
# 2026-10-04, 2026-12-13 and 2027-01-24.
FAKE_TODAY=

# ---- GitHub ------------------------------------------------------
# Optional. Without a token the sync falls back to 60 requests an hour per IP
# instead of 5,000, and the app says so on /pushes.
GITHUB_API=https://api.github.com

# ---- Backups -----------------------------------------------------
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
MYSQLDUMP_BIN=mysqldump

# ------------------------------------------------------------------
# BEFORE YOU PUT THIS ON THE INTERNET
#
# Change every one of these from the development values above:
#
#   NODE_ENV=production      turns on the secure cookie flag and HSTS, and makes
#                            TOKEN_ENC_KEY mandatory rather than optional
#   HOST=127.0.0.1           keep it. nginx or the host router terminates TLS and
#                            proxies to it. Never bind 0.0.0.0 on a public box
#                            unless something else is doing the filtering
#   PORT=3000                or whatever the proxy forwards to
#   PUBLIC_ORIGIN=https://your-domain    https, no trailing slash. The ICS export
#                            and the web manifest use it to build absolute URLs
#   TRUST_PROXY=1            so req.ip is the real client and the rate limiters
#                            work per visitor rather than per proxy. Only set this
#                            when there really is a proxy in front, and make sure
#                            it overwrites X-Forwarded-For rather than appending
#                            to whatever the client sent
#   DB_PASSWORD=             a long random value, not the development one
#   SESSION_SECRET=          a fresh 64 hex characters
#   TOKEN_ENC_KEY=           a fresh 64 hex characters, different from the above
#   ALLOW_SIGNUP=            leave unset, so signup closes after the first account
#
# Then check it:
#   curl -sI https://your-domain/login | grep -i 'strict-transport\|set-cookie'
#     expect Strict-Transport-Security, and Secure on the cookie
#   curl -s https://your-domain/robots.txt        expect Disallow: /
#   curl -s -o /dev/null -w '%{http_code}\n' https://your-domain/signup
#     expect 403 once the account exists
#   npm audit --omit=dev                          expect 0 vulnerabilities
# ------------------------------------------------------------------

