# Line endings.
#
# Everything text is stored with LF in the repository and checked out with the
# platform's own ending. Without this, a clone on Windows and a clone on Linux
# produce a whole-file diff on every file, which buries a real change.

* text=auto eol=lf

# Windows only, so it keeps CRLF in the working copy.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Shell scripts must be LF or the shebang breaks.
*.sh   text eol=lf

# Binary, so git never tries to convert or diff them as text.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary
*.zip  binary
*.gz   binary

# Generated by the parser and reviewed as text, but very large. Marking them
# linguist-generated keeps them out of the language statistics and collapses them
# in a pull request, without excluding them from a diff when you want one.
migrations/*.sql linguist-generated=true
data/final.md    linguist-documentation=true
